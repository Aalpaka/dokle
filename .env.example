# Lokalno: docker compose up -d, pa kopiraj ovu datoteku u .env
# Produkcija: connection string iz Supabase (Project settings > Database), upisuje se u Vercel, ne u repo.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dokle

# Supabase (Project settings > API Keys). Bez njih igra radi, ali bez prijave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tajni ključ, samo na serveru: treba za brisanje računa iz Supabase Autha
SUPABASE_SERVICE_ROLE_KEY=
# Tko vidi /admin (Gmail adrese, odvojene zarezom)
ADMIN_EMAILS=
# Samo lokalno: /admin bez prijave (u produkciji se ignorira)
# ADMIN_DEV_BYPASS=1

# Koji skin se servira (hr; kasnije ba, rs)
DEFAULT_SKIN=hr
